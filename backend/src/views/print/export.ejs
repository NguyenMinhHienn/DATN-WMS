<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Phiếu Xuất Kho <%= receipt.receipt_number %></title>
    <style>
        body { font-family: 'Arial', sans-serif; color: #333; margin: 0; padding: 20px; font-size: 14px; }
        .page { width: 100%; max-width: 800px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; margin-bottom: 30px; border-bottom: 2px solid #555; padding-bottom: 10px; }
        .company-info h1 { margin: 0; font-size: 20px; color: #d97706; }
        .company-info p { margin: 2px 0; font-size: 13px; color: #555; }
        .receipt-info { text-align: right; }
        .receipt-info h2 { margin: 0; font-size: 24px; color: #333; text-transform: uppercase; }
        .receipt-info p { margin: 5px 0 0; font-size: 14px; font-weight: bold; }
        .info-section { margin-bottom: 20px; display: flex; flex-wrap: wrap; }
        .info-block { width: 50%; margin-bottom: 15px; }
        .info-block-full { width: 100%; margin-bottom: 15px; }
        .info-label { font-weight: bold; color: #666; display: inline-block; width: 120px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        table, th, td { border: 1px solid #ddd; }
        th { background-color: #f8f9fa; padding: 10px; text-align: left; font-size: 13px; color: #333; }
        td { padding: 8px 10px; font-size: 13px; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .totals { width: 100%; display: flex; justify-content: flex-end; margin-bottom: 40px; }
        .totals table { width: 300px; border: none; }
        .totals table td { border: none; padding: 5px 10px; }
        .totals .final-total { font-weight: bold; font-size: 16px; border-top: 2px solid #333 !important; }
        .signatures { display: flex; justify-content: space-between; margin-top: 50px; text-align: center; }
        .signature-block { width: 25%; }
        .signature-title { font-weight: bold; margin-bottom: 60px; }
        .signature-name { font-style: italic; color: #666; }
        .notes { font-style: italic; font-size: 13px; color: #555; margin-bottom: 20px; }

        /* ===== Cross-Reference Panel ===== */
        .xref-section {
            border: 1.5px solid #d97706;
            border-radius: 8px;
            padding: 12px 16px;
            margin: 15px 0 20px 0;
            background: #fffbeb;
            page-break-inside: avoid;
        }
        .xref-title {
            font-size: 14px;
            font-weight: bold;
            color: #d97706;
            margin: 0 0 10px 0;
            padding-bottom: 6px;
            border-bottom: 1px dashed #fbbf24;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .xref-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }
        .xref-table th {
            background: #fef3c7;
            color: #92400e;
            padding: 6px 10px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            border: 1px solid #fbbf24;
        }
        .xref-table td {
            padding: 6px 10px;
            border: 1px solid #fde68a;
            background: white;
            vertical-align: top;
        }
        .xref-code {
            font-weight: bold;
            color: #92400e;
            font-family: 'Consolas', monospace;
        }
        .xref-note {
            font-size: 11px;
            color: #666;
            font-style: italic;
        }
        .xref-empty {
            color: #999;
            font-style: italic;
            font-size: 12px;
            padding: 8px 0;
        }

        @media print {
            body { padding: 0; background-color: white; }
            .no-print { display: none; }
            @page { margin: 15mm; }
        }
        .btn-print { background: #d97706; color: white; border: none; padding: 10px 20px; cursor: pointer; border-radius: 4px; font-weight: bold; position: fixed; top: 20px; right: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }

        /* ===== Receipt Type Badge ===== */
        .receipt-type-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 0.5px;
            margin-top: 6px;
        }
        .badge-normal {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #a5d6a7;
        }
        .badge-credit {
            background: #fce4ec;
            color: #c62828;
            border: 1px solid #ef9a9a;
        }

        /* ===== Debt Info Section ===== */
        .debt-section {
            border: 2px solid #c62828;
            border-radius: 8px;
            padding: 15px 20px;
            margin: 20px 0;
            background: linear-gradient(135deg, #fce4ec 0%, #ffebee 100%);
            page-break-inside: avoid;
        }
        .debt-section-title {
            font-size: 16px;
            font-weight: bold;
            color: #c62828;
            margin: 0 0 12px 0;
            padding-bottom: 8px;
            border-bottom: 1px dashed #ef9a9a;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .debt-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 20px;
        }
        .debt-item {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
        }
        .debt-label {
            color: #795548;
            font-weight: 600;
            font-size: 13px;
        }
        .debt-value {
            font-weight: bold;
            color: #333;
            font-size: 13px;
        }
        .debt-status {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .status-unpaid { background: #ffcdd2; color: #c62828; }
        .status-partial { background: #fff9c4; color: #f57f17; }
        .status-paid { background: #c8e6c9; color: #2e7d32; }
        .status-overdue { background: #f44336; color: white; }
        
        .debt-amount-highlight {
            font-size: 18px;
            font-weight: bold;
            color: #c62828;
            text-align: right;
            padding-top: 8px;
            margin-top: 8px;
            border-top: 1px solid #ef9a9a;
        }
    </style>
</head>
<body>
    <button class="btn-print no-print" onclick="window.print()">🖨️ In Phiếu Này</button>
    <div class="page">
        <div class="header">
            <div class="company-info">
                <h1><%= company.name %></h1>
                <p>📍 <%= company.address %></p>
                <p>📞 <%= company.phone %> | ✉️ <%= company.email %></p>
            </div>
            <div class="receipt-info">
                <h2>PHIẾU XUẤT KHO</h2>
                <p>Mã Số: <%= receipt.receipt_number %></p>
                <p style="font-weight: normal; font-size: 12px; margin-top: 2px;">
                    Ngày: <%= formatDate(receipt.receipt_date) %>
                </p>
                <%
                    var hasDebt = (typeof receivable !== 'undefined' && receivable) || (receipt.payment_terms > 0);
                %>
                <% if (hasDebt) { %>
                    <span class="receipt-type-badge badge-credit">💳 CÔNG NỢ</span>
                <% } else { %>
                    <span class="receipt-type-badge badge-normal">✅ THANH TOÁN NGAY</span>
                <% } %>
            </div>
        </div>

        <div class="info-section">
            <div class="info-block">
                <span class="info-label">Kho Xuất:</span> <%= receipt.warehouse_name %>
            </div>
            <div class="info-block">
                <span class="info-label">Lý Do Xuất:</span> 
                <% if (receipt.export_reason === 'sale') { %> Bán hàng
                <% } else if (receipt.export_reason === 'internal') { %> Tiêu dùng nội bộ
                <% } else if (receipt.export_reason === 'transfer') { %> Luân chuyển
                <% } else { %> Khác <% } %>
            </div>
            <div class="info-block">
                <span class="info-label">Người Nhận:</span> <%= receipt.receiver_name || 'N/A' %>
            </div>
            <% if (receipt.receiver_department) { %>
            <div class="info-block">
                <span class="info-label">Phòng Ban:</span> <%= receipt.receiver_department %>
            </div>
            <% } %>
            <% if (receipt.payment_method) { %>
            <div class="info-block">
                <span class="info-label">Thanh toán:</span> <strong><%= receipt.payment_method %></strong>
            </div>
            <% } %>
            <div class="info-block-full">
                <span class="info-label">Địa Chỉ/SĐT Nhận:</span> 
                <%= receipt.receiver_address || '' %> <%= receipt.receiver_phone ? ' (Tel: ' + receipt.receiver_phone + ')' : '' %>
            </div>
        </div>

        <%# ===== BẢNG CHỨNG TỪ LIÊN QUAN (Cross-Reference) ===== %>
        <div class="xref-section">
            <div class="xref-title">
                <span>📎</span> CHỨNG TỪ ĐI KÈM / THAM CHIẾU
            </div>
            <% if (typeof linkedDocuments !== 'undefined' && linkedDocuments && linkedDocuments.length > 0) { %>
            <table class="xref-table">
                <thead>
                    <tr>
                        <th width="5%">#</th>
                        <th width="30%">Loại chứng từ</th>
                        <th width="30%">Mã / Số hiệu</th>
                        <th width="35%">Ghi chú truy xuất</th>
                    </tr>
                </thead>
                <tbody>
                    <% linkedDocuments.forEach(function(doc, idx) { %>
                    <tr>
                        <td class="text-center"><%= idx + 1 %></td>
                        <td><%= doc.icon %> <%= doc.type %></td>
                        <td class="xref-code"><%= doc.code %></td>
                        <td class="xref-note"><%= doc.note || '' %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <p class="xref-empty">Không có chứng từ liên quan nào được ghi nhận trong hệ thống cho phiếu này.</p>
            <% } %>
        </div>

        <% if (receipt.notes) { %>
        <div class="notes">
            <strong>Ghi chú:</strong> <%= receipt.notes %>
        </div>
        <% } %>

        <table>
            <thead>
                <tr>
                    <th class="text-center" width="5%">STT</th>
                    <th width="35%">Tên Sản Phẩm</th>
                    <th width="15%">SKU</th>
                    <th class="text-center" width="10%">ĐVT</th>
                    <th class="text-right" width="10%">SL</th>
                    <th class="text-right" width="12%">Đơn Giá</th>
                    <th class="text-right" width="13%">Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach(function(item, index) { %>
                <tr>
                    <td class="text-center"><%= index + 1 %></td>
                    <td>
                        <strong><%= item.product_name %></strong>
                        <% if (item.variant_sku && item.variant_sku !== item.sku) { %>
                            <br><span style="font-size: 11px; color: #666;">(Biến thể: <%= item.variant_sku %>)</span>
                        <% } %>
                    </td>
                    <td><%= item.variant_sku || item.sku %></td>
                    <td class="text-center"><%= item.unit_name || '-' %></td>
                    <td class="text-right font-weight-bold"><%= item.quantity_actual || item.quantity_requested %></td>
                    <td class="text-right"><%= formatCurrency(item.unit_price) %></td>
                    <td class="text-right"><%= formatCurrency(item.line_total) %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="totals">
            <table>
                <tr>
                    <td class="text-right">Tổng mặt hàng:</td>
                    <td class="text-right" width="150"><%= receipt.total_items %></td>
                </tr>
                <tr>
                    <td class="text-right">Tổng tiền hàng:</td>
                    <td class="text-right"><%= formatCurrency(receipt.subtotal || receipt.total_amount) %></td>
                </tr>
                <% var vatPct = Number(receipt.vat_percent) || 0; %>
                <% var vatAmt = Number(receipt.vat_amount) || 0; %>
                <% if (vatAmt > 0) { %>
                <tr>
                    <td class="text-right">VAT (<%= (vatPct * 100).toFixed(0) %>%):</td>
                    <td class="text-right"><%= formatCurrency(vatAmt) %></td>
                </tr>
                <% } %>
                <% var shipFee = Number(receipt.shipping_fee) || 0; %>
                <% if (shipFee > 0) { %>
                <tr>
                    <td class="text-right">Phí vận chuyển:</td>
                    <td class="text-right"><%= formatCurrency(shipFee) %></td>
                </tr>
                <% } %>
                <tr>
                    <td class="text-right final-total">TỔNG THANH TOÁN:</td>
                    <td class="text-right final-total"><%= formatCurrency(receipt.total_amount) %></td>
                </tr>
            </table>
        </div>

        <%# ===== PHẦN CÔNG NỢ PHẢI THU (KHÁCH HÀNG) ===== %>
        <% if (typeof receivable !== 'undefined' && receivable) { %>
        <div class="debt-section">
            <div class="debt-section-title">
                <span>📋</span> THÔNG TIN CÔNG NỢ PHẢI THU (KHÁCH HÀNG)
            </div>
            <div class="debt-grid">
                <div class="debt-item">
                    <span class="debt-label">Mã công nợ:</span>
                    <span class="debt-value"><%= receivable.receivable_number %></span>
                </div>
                <div class="debt-item">
                    <span class="debt-label">Trạng thái:</span>
                    <span class="debt-value">
                        <% var rStatus = receivable.status || 'unpaid'; %>
                        <% if (rStatus === 'unpaid') { %>
                            <span class="debt-status status-unpaid">Chưa thanh toán</span>
                        <% } else if (rStatus === 'partial') { %>
                            <span class="debt-status status-partial">Thanh toán một phần</span>
                        <% } else if (rStatus === 'paid') { %>
                            <span class="debt-status status-paid">Đã thanh toán</span>
                        <% } else if (rStatus === 'overdue') { %>
                            <span class="debt-status status-overdue">⚠ Quá hạn</span>
                        <% } else { %>
                            <span class="debt-status"><%= rStatus %></span>
                        <% } %>
                    </span>
                </div>
                <div class="debt-item">
                    <span class="debt-label">Người nợ:</span>
                    <span class="debt-value"><%= receivable.debtor_name || 'N/A' %></span>
                </div>
                <div class="debt-item">
                    <span class="debt-label">SĐT:</span>
                    <span class="debt-value"><%= receivable.debtor_phone || 'N/A' %></span>
                </div>
                <% if (receivable.payment_terms > 0) { %>
                <div class="debt-item">
                    <span class="debt-label">Hạn thanh toán:</span>
                    <span class="debt-value"><%= receivable.payment_terms %> ngày</span>
                </div>
                <% } %>
                <% if (receivable.due_date) { %>
                <div class="debt-item">
                    <span class="debt-label">Ngày đến hạn:</span>
                    <span class="debt-value"><%= formatDate(receivable.due_date) %></span>
                </div>
                <% } %>
                <div class="debt-item">
                    <span class="debt-label">Tổng nợ:</span>
                    <span class="debt-value"><%= formatCurrency(receivable.total_amount) %></span>
                </div>
                <div class="debt-item">
                    <span class="debt-label">Đã thu:</span>
                    <span class="debt-value"><%= formatCurrency(receivable.paid_amount || 0) %></span>
                </div>
            </div>
            <div class="debt-amount-highlight">
                Còn phải thu: <%= formatCurrency((receivable.total_amount || 0) - (receivable.paid_amount || 0)) %>
            </div>
        </div>
        <% } else if (receipt.payment_terms > 0) { %>
        <%# Fallback: nếu có payment_terms trên phiếu nhưng chưa có bản ghi receivable %>
        <div class="debt-section">
            <div class="debt-section-title">
                <span>⚠️</span> PHIẾU CÓ ĐIỀU KHOẢN CÔNG NỢ
            </div>
            <div class="debt-grid">
                <div class="debt-item">
                    <span class="debt-label">Hạn thanh toán:</span>
                    <span class="debt-value"><%= receipt.payment_terms %> ngày</span>
                </div>
                <div class="debt-item">
                    <span class="debt-label">Trạng thái:</span>
                    <span class="debt-value"><span class="debt-status status-unpaid">Chờ xử lý</span></span>
                </div>
            </div>
        </div>
        <% } %>

        <div class="signatures">
            <div class="signature-block">
                <div class="signature-title">Người Lập Phiếu</div>
                <div class="signature-name"><%= receipt.created_by_name || '.........................' %></div>
            </div>
            <div class="signature-block">
                <div class="signature-title">Người Nhận</div>
                <div class="signature-name"><%= receipt.receiver_name || '.........................' %></div>
            </div>
            <div class="signature-block">
                <div class="signature-title">Thủ Kho</div>
                <div class="signature-name"><%= receipt.storekeeper || '.........................' %></div>
            </div>
            <div class="signature-block">
                <div class="signature-title">Quản Lý / Kế Toán</div>
                <div class="signature-name"><%= receipt.approved_by_name || '.........................' %></div>
            </div>
        </div>
    </div>

    <script>
        window.onload = function() {
            setTimeout(() => {
                window.print();
            }, 500);
        }
    </script>
</body>
</html>
